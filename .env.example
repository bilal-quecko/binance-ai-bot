# App
APP_NAME=binance-ai-bot
APP_ENV=dev
APP_MODE=paper
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Trading defaults
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=1m,5m,15m
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=3
AI_ENABLED=false

# Continuous market intelligence (paper/advisory only)
CONTINUOUS_INTELLIGENCE_ENABLED=true
CONTINUOUS_INTELLIGENCE_MARKETS=spot,futures
CONTINUOUS_INTELLIGENCE_QUOTE_ASSET=USDT
CONTINUOUS_INTELLIGENCE_UNIVERSE_LIMIT=50
CONTINUOUS_INTELLIGENCE_CYCLE_SECONDS=300
CONTINUOUS_INTELLIGENCE_UNIVERSE_REFRESH_SECONDS=1800
CONTINUOUS_INTELLIGENCE_DEEP_CANDIDATE_LIMIT=12
CONTINUOUS_INTELLIGENCE_FAST_SCORE_THRESHOLD=45
CONTINUOUS_INTELLIGENCE_CONCURRENCY=4
CONTINUOUS_INTELLIGENCE_REQUEST_INTERVAL_MS=50
CONTINUOUS_INTELLIGENCE_INITIAL_DELAY_SECONDS=2

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_DERIVATIVES_DATA_ENABLED=true
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Liquidation heatmap enrichment
# mock keeps the app fully local. binance_force_orders uses actual USD-M Futures
# force-liquidation events after they occur. vendor_http requires a configured
# endpoint that returns normalizable heatmap fields.
HEATMAP_PROVIDER=mock
HEATMAP_VENDOR_BASE_URL=
HEATMAP_VENDOR_API_KEY=
HEATMAP_VENDOR_NAME=
HEATMAP_VENDOR_CLUSTERS_PATH=
HEATMAP_VENDOR_SYMBOL_PARAM=symbol
HEATMAP_REQUEST_TIMEOUT_SECONDS=10

# Storage
# Local SQLite state is stored under ./data so paper sessions, signal history,
# validation snapshots, and runtime recovery survive backend restarts.
DATABASE_URL=sqlite:///./data/binance_ai_bot.db
